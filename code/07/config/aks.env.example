# Optional Azure inputs. Defaults are resolved by scripts/common.sh.
AZURE_RESOURCE_GROUP=rg-kinfey
AKS_NAME=aks-kars-demo
KARS_ACR_NAME=akskarsdemo449845
LOG_ANALYTICS_WORKSPACE=log-aks-kars-demo

# Leave empty to reuse the existing resource group's Azure location, or eastus2
# when the resource group does not exist yet.
AZURE_LOCATION=

KARS_SANDBOX_NAME=forge-intake
KARS_RELEASE=v0.1.25
KARS_ISOLATION=enhanced
KARS_MESH_TRUST=anonymous
GITHUB_COPILOT_MODEL=gpt-5.6-sol

# Safe default: create no Azure resources.
DEPLOY_AKS=false

# Plan-only placeholder. Real deployment builds this image through ACR Tasks
# and automatically replaces it with the resulting sha256 digest reference.
FORGE_IMAGE=

# Optional path to an Azure/KARS source checkout containing deploy/helm/kars
# and deploy/agentmesh-agt.yaml.
KARS_SOURCE_ROOT=
